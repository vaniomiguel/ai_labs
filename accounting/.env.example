DATABASE_PASSWORD=replace-with-a-strong-database-password
ADMIN_USERNAME=gestor
ADMIN_PASSWORD=replace-with-a-strong-owner-password
SPRING_PROFILES_ACTIVE=dev
# Por omissão: Java local usa localhost:11434; Java no Docker usa host.docker.internal:11434.
# Definir OLLAMA_URL apenas para substituir o endereço no modo de execução escolhido.
# O lançador híbrido aceita HYBRID_OLLAMA_URL para uma substituição própria.
AI_ENABLED=true
# Vazio revê todas as folhas históricas; limitar apenas em ensaios, por exemplo 1,2,3.
AI_HISTORY_MONTHS=
